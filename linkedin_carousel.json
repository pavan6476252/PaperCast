              "data": [
                {
                  "no": "01",
                  "item": "Conditional expressions",
                  "note": "Something like 'hide this if total > 0' — beyond the built-in page conditions."
                },
                {
                  "no": "02",
                  "item": "Plainer validation errors",
                  "note": "Right now a schema mistake throws a raw Ajv error. Wants to read like plain English instead."
                },
                {
                  "no": "03",
                  "item": "A sturdier PDF export",
                  "note": "Most of my recent releases were deployment fixes, not features — want that to stop being true."
                },
                {
                  "no": "04",
                  "item": "A proper contribution guide",
                  "note": "As more people start using this, I'd like a clear way for folks to pitch in."
                }
              ],
              "styleConfig": {
                "gridLines": "none",
                "headerBackgroundColor": "#FFF",
                "alternateRowColor": "#FFF"
              }
            }
