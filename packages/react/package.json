{
  "name": "@papercast/react",
  "version": "0.1.0",
  "private": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./headless": {
      "types": "./src/headless/index.ts",
      "default": "./src/headless/index.ts"
    },
    "./widgets": {
      "types": "./src/widgets/index.ts",
      "default": "./src/widgets/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@papercast/core": "workspace:*",
    "@papercast/engine": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": "^0.300.0 || ^0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pavan6476252/papercast"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
